# yaseo — пример файла ключей.
# Скопируйте в ~/.config/yaseo/.env (или в свой файл, путь — в YASEO_ENV_FILE)
# и заполните, либо выполните `yaseo init` — он спросит ключи и запишет файл сам.
# ./.env текущего каталога не читается: сервер запускается из каталога любого
# вашего проекта, и чужой .env не должен подмешиваться сюда.

# Обязательно для выдачи (Search API) и частотности (Wordstat).
# Где взять: https://aistudio.yandex.ru — сервисный аккаунт и API-ключ к нему.
YC_FOLDER_ID=
YANDEX_AI_STUDIO_API_KEY=

# Необязательно: Яндекс.Вебмастер и Метрика (OAuth-приложение на https://oauth.yandex.ru).
# Токены получает команда: yaseo yandex --exchange <код>
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_TOKEN=
YANDEX_OAUTH_REFRESH=

# Необязательные настройки.
# YASEO_DB=~/.local/share/yaseo/yaseo.db
# YASEO_DOMAIN=example.ru
# YASEO_USE_PROXY=0
# YASEO_TRACKING_MAX_CALLS=1000
# YASEO_TRACKING_MIN_INTERVAL_DAYS=13
